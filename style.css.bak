@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;700&display=swap');
:root{--ink:#11120e;--paper:#f2f2e9;--acid:#d9ff43;--muted:#a5a79c;--line:#3a3c32;font-family:'DM Sans',Arial,sans-serif;color:var(--paper);background:var(--ink);font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0}a{color:inherit;text-decoration:none}button{font:inherit}a,button{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:3px solid var(--acid);outline-offset:5px}img{display:block;max-width:100%}.skip{position:absolute;top:-80px;left:20px;padding:16px;background:var(--acid);color:var(--ink);z-index:200}.skip:focus{top:10px}.nav{height:105px;padding:0 4%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:30px}.wordmark{font-size:19px;font-weight:700;line-height:.95;letter-spacing:-1px;position:relative}.logo-dot{position:absolute;right:-16px;top:-2px;font-size:12px}.nav-title{font-size:12px;line-height:1.5;letter-spacing:.05em;margin-right:auto;margin-left:12%}.nav nav{display:flex;align-items:center;gap:32px;font-size:14px}.nav nav a:hover{color:var(--acid)}sup{font-size:10px;padding-left:4px}.contact-link{border:1px solid #777a69;border-radius:50px;padding:13px 22px}.hero{padding:25px 4% 34px;overflow:hidden}.hero-top,.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:22px}.hero-top{font-size:12px;letter-spacing:.11em;color:var(--muted)}.hero-content{display:grid;grid-template-columns:1.12fr 1fr;align-items:center;min-height:565px}.hero-copy{z-index:2;padding:35px 0}.hero h1{font-family:'Barlow Condensed','Arial Narrow',Impact,sans-serif;font-weight:800;font-size:clamp(88px,11.6vw,190px);line-height:.82;letter-spacing:-.025em;margin:0}.hero h1 span{color:var(--acid)}.serif{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400;letter-spacing:-.05em}.hero .serif{font-size:clamp(28px,3.3vw,51px);line-height:1.05;margin:28px 0 0 4px}.hero-gallery{height:470px;position:relative;min-width:0}.hero-piece{display:block;position:absolute;padding:10px 10px 0;background:var(--paper);color:var(--ink);box-shadow:0 20px 50px #0007;transition:transform .5s}.hero-piece img{width:100%;aspect-ratio:1.765;object-fit:cover}.hero-piece span{display:block;font-size:11px;letter-spacing:.1em;padding:9px 0}.piece-one{width:91%;left:0;top:26px;transform:rotate(-8deg)}.piece-two{width:72%;right:0;bottom:7px;transform:rotate(9deg)}.piece-one:hover{transform:rotate(-3deg) translateY(-8px);z-index:4}.piece-two:hover{transform:rotate(4deg) translateY(-8px);z-index:4}.hero-sticker{display:grid;place-content:center;position:absolute;right:-5px;top:3px;width:115px;height:115px;border-radius:50%;background:var(--acid);color:var(--ink);font-weight:700;text-align:center;font-size:20px;line-height:.97;transform:rotate(13deg);z-index:5}.hero-bottom{padding-top:18px;border-top:1px solid var(--line)}.hero-bottom p{font-size:15px;line-height:1.5;margin:0}.hero-index{font-size:11px;color:var(--muted);line-height:1.5;letter-spacing:.06em}.pill{display:flex;justify-content:space-between;gap:32px;padding:15px 22px;border:1px solid var(--paper);border-radius:50px;font-size:14px;transition:.2s}.pill:hover{background:var(--acid);color:var(--ink);border-color:var(--acid)}.pill span{font-size:20px;line-height:18px}.ticker{background:var(--acid);color:var(--ink);overflow:hidden;padding:16px 0}.ticker>div{font-size:16px;font-weight:700;white-space:nowrap;letter-spacing:.1em;width:max-content;animation:marquee 35s linear infinite}.ticker span{padding:0 35px;font-size:23px}.work{padding:100px 4% 80px}.section-head{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:start;gap:25px;margin-bottom:65px}.eyebrow{font-size:12px;letter-spacing:.1em}.section-head h2{font-size:clamp(30px,3.4vw,55px);font-weight:500;letter-spacing:-.04em;line-height:1.1;margin:0}.section-head p{font-size:14px;color:var(--muted);line-height:1.6;margin:8px 0}.project{display:block}.project-image{position:relative;overflow:hidden;background:#21231a}.featured .project-image{height:min(61vw,720px)}.project-image img{width:100%;height:100%;object-fit:cover;transition:transform .7s}.featured .project-image img{object-position:center 48%}.project:hover .project-image img{transform:scale(1.025)}.view-label{position:absolute;right:25px;bottom:25px;background:var(--paper);color:var(--ink);border-radius:50px;padding:15px 22px;font-size:12px;font-weight:600;box-shadow:0 5px 20px #0003;transition:.25s}.project:hover .view-label{background:var(--acid)}.project-caption{display:flex;align-items:baseline;gap:20px;padding:22px 0;border-bottom:1px solid var(--line)}.project-caption h3{font-size:30px;letter-spacing:-.05em;font-weight:500;margin:0}.project-number{color:var(--muted);font-size:12px}.project-caption p{font-size:11px;letter-spacing:.06em;margin:0;color:var(--muted)}.project-type{margin-left:auto;font-size:11px;letter-spacing:.06em}.project-grid{display:grid;grid-template-columns:1fr 1fr;gap:65px 28px;margin-top:65px}.project-grid .project-image{aspect-ratio:1.36}.project-grid .project-caption{flex-wrap:wrap;gap:10px 15px}.project-grid h3{font-size:27px}.project-grid .project-type{font-size:10px}.project-grid .project-caption p{flex-basis:100%;padding-left:29px}.wide-project{grid-column:1/-1}.wide-project .project-image{aspect-ratio:2.12}.work-end{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);padding-top:30px}.about{background:var(--paper);color:var(--ink);padding:100px 4%;display:grid;grid-template-columns:1fr 3fr;gap:30px}.about h2{font-size:clamp(44px,6vw,90px);letter-spacing:-.055em;font-weight:500;line-height:1;margin:0 0 35px}.about-intro{display:grid;grid-template-columns:1.4fr 1fr;gap:8%;align-items:start}.about p{font-size:19px;line-height:1.55;max-width:590px}.practice-list{padding:0;margin:15px 0 0;list-style:none}.practice-list li{border-top:1px solid #bcbdaf;padding:15px 0;font-size:14px}.practice-list span{color:#777c66;margin-right:17px;font-size:11px}.contact{padding:90px 4% 0}.contact-head{display:flex;justify-content:space-between;gap:20px}.contact h2{font-family:'Barlow Condensed','Arial Narrow',Impact,sans-serif;font-weight:800;font-size:clamp(85px,14vw,220px);line-height:.87;letter-spacing:-.025em;margin:70px 0 40px;max-width:1100px}.contact h2 span{color:var(--acid)}.contact-info{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:35px 0 65px}.email{font-size:clamp(18px,2.8vw,44px);border-bottom:1px solid #777;letter-spacing:-.04em}.email:hover{color:var(--acid)}.phone{font-size:16px;color:var(--muted)}.contact footer{border-top:1px solid var(--line);display:flex;justify-content:space-between;padding:25px 0;font-size:12px;color:var(--muted)}dialog{width:100%;max-width:none;height:100%;max-height:none;border:0;padding:0;background:var(--ink);color:var(--paper);overscroll-behavior:contain}dialog::backdrop{background:#000c}.close-case{position:fixed;z-index:30;top:22px;right:4%;background:var(--paper);color:var(--ink);border:0;border-radius:40px;padding:13px 20px;cursor:pointer;font-size:14px;box-shadow:0 5px 20px #0003}.close-case span{font-size:20px;margin-left:22px}.case-header{padding:75px 6% 45px}.case-header .eyebrow{color:var(--acid)}.case-header h2{font-family:'Barlow Condensed','Arial Narrow',Impact,sans-serif;font-size:clamp(65px,11vw,165px);font-weight:700;line-height:.9;margin:26px 0 20px;text-transform:uppercase;letter-spacing:-.02em}.case-deck{font-family:Georgia,serif;font-style:italic;font-size:clamp(26px,3.6vw,52px);letter-spacing:-.035em;line-height:1.1;margin:0}.case-hero{width:100%;max-height:900px;object-fit:contain;background:#080906}.case-details{padding:65px 6%;display:grid;grid-template-columns:1fr 1fr;gap:8%}.case-details h3{font-size:12px;letter-spacing:.1em;color:var(--acid);font-weight:400}.case-details p{font-size:19px;line-height:1.6;max-width:680px}.case-gallery{padding:0 6% 65px;display:grid;grid-template-columns:1fr 1fr;gap:28px}.case-gallery figure{margin:0;align-self:start}.case-gallery figure.full{grid-column:1/-1}.case-gallery img{width:100%;height:auto}.case-gallery figcaption{font-size:13px;color:var(--muted);padding-top:12px;line-height:1.6}.case-next{display:flex;align-items:center;justify-content:space-between;margin:0 6%;border-top:1px solid var(--line);padding:40px 0 60px;font-size:clamp(24px,4vw,52px)}.case-next small{font-size:12px;color:var(--muted)}.pdf-link{display:inline-block;font-size:14px;border-bottom:1px solid;margin-top:10px;padding-bottom:5px}.reveal{animation:fadein .7s both}@keyframes marquee{to{transform:translateX(-50%)}}@keyframes fadein{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:none}}@media(min-width:1700px){.hero-content{min-height:700px}.hero-gallery{height:580px}}@media(max-width:900px){.nav-title{display:none}.hero-content{min-height:500px}.hero-gallery{height:360px}.hero-sticker{width:85px;height:85px;font-size:16px}.hero-index{display:none}.hero h1{font-size:13vw}.section-head{grid-template-columns:1fr 2fr}.section-head p{grid-column:2}.project-caption{flex-wrap:wrap}.project-caption p{display:none}.about{grid-template-columns:1fr}.about-intro{gap:5%}.contact-info{align-items:start;flex-direction:column;gap:20px}}@media(max-width:600px){html{scroll-padding-top:30px}.nav{height:85px;padding:0 6%;gap:20px}.wordmark{font-size:16px}.nav nav{gap:17px;font-size:13px}.contact-link{padding:10px 13px}.nav sup{display:none}.hero{padding:20px 6% 28px}.hero-top{font-size:10px;letter-spacing:.05em}.hero-content{display:flex;flex-direction:column;align-items:stretch}.hero-copy{padding:40px 0 15px}.hero h1{font-size:22vw}.hero .serif{font-size:32px;margin-top:20px}.hero .serif br{display:none}.hero-gallery{height:335px;margin:5px 0 28px;max-width:450px}.piece-one{width:85%;top:23px;left:1%}.piece-two{width:70%;right:1%;bottom:2px}.hero-sticker{top:6px;right:0;width:78px;height:78px;font-size:14px}.hero-bottom{flex-direction:column;align-items:stretch;gap:20px}.hero-bottom p{font-size:14px}.pill{align-self:flex-start}.ticker{padding:12px 0}.ticker>div{font-size:13px}.work{padding:65px 6%}.section-head{display:block;margin-bottom:35px}.section-head h2{font-size:37px;margin:25px 0 15px}.section-head p{font-size:14px}.featured .project-image{height:100vw}.project-caption{padding:17px 0;gap:12px}.project-caption h3{font-size:26px}.project-type{font-size:10px;margin-left:0;flex-basis:100%;padding-left:27px}.view-label{right:15px;bottom:15px;font-size:11px;padding:12px 15px}.project-grid{display:block;margin-top:38px}.project-grid .project{margin-bottom:38px}.project-grid .project-image{aspect-ratio:1.15}.project-grid .wide-project .project-image{aspect-ratio:1.45}.project-grid .project-caption{gap:12px}.project-grid .project-type{margin-left:0}.work-end{font-size:11px;gap:15px}.about{padding:65px 6%}.about h2{font-size:47px;margin-top:10px}.about-intro{display:block}.about p{font-size:17px}.practice-list{margin-top:30px}.contact{padding:65px 6% 0}.contact-head{font-size:11px}.contact-head .eyebrow{font-size:11px}.contact h2{font-size:21vw;margin-top:50px}.contact-info{padding:10px 0 50px}.email{font-size:6vw}.contact footer{font-size:10px;gap:20px}.case-header{padding:100px 6% 30px}.case-header h2{font-size:19vw}.case-header .eyebrow{font-size:10px}.case-details{grid-template-columns:1fr;gap:16px;padding:35px 6%}.case-details p{font-size:17px}.case-gallery{display:block;padding-bottom:30px}.case-gallery figure{margin-bottom:30px}.case-next{padding-bottom:40px;gap:20px}.close-case{top:16px}.case-next small{font-size:10px}.project-image img{object-position:center}.featured .project-image img{object-position:center}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
.hero-credit{padding:12px 6% 0;font-size:12px;line-height:1.5;color:var(--muted);margin:0}.featured .project-image{height:auto;aspect-ratio:1.9}.featured .project-image img{object-position:center 52%;height:100%}@media(max-width:600px){.featured .project-image{aspect-ratio:1.15}.hero-credit{font-size:12px}}
.hero-piece img{height:auto}.project-caption p,.project-type,.hero-index,.hero-piece span,.project-grid .project-type{font-size:12px}@media(max-width:600px){.project-type,.project-grid .project-type{font-size:12px}.hero-top{font-size:12px;gap:20px}.hero-top span:last-child{text-align:right}.contact footer{font-size:12px;flex-wrap:wrap}.nav sup{display:none}}
/* Expanded exhibition */
.work-tools{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-bottom:35px}.filters{display:flex;flex-wrap:wrap;gap:9px}.filter{border:1px solid var(--line);border-radius:40px;background:transparent;color:var(--paper);padding:12px 20px;font-size:14px;cursor:pointer;transition:background .2s,color .2s}.filter:hover,.filter.active{background:var(--acid);border-color:var(--acid);color:var(--ink)}#project-count{color:var(--muted);font-size:12px;white-space:nowrap}.expanded-grid{margin-top:0;gap:65px 30px}.expanded-grid .project[hidden]{display:none}.expanded-grid .project-image{aspect-ratio:1.5}.expanded-grid .wide-project .project-image{aspect-ratio:1.8}.project-tag{position:absolute;top:20px;left:20px;background:#11120ee6;color:var(--paper);padding:9px 13px;font-size:12px;letter-spacing:.06em;border:1px solid #ffffff35}.expanded-grid .project-caption p{display:block;margin-left:auto;flex-basis:auto;font-size:14px;letter-spacing:0;padding-left:0;text-transform:none;max-width:55%}.expanded-grid .project-caption h3{font-size:30px}.expanded-grid .project-image img{transition:transform .8s cubic-bezier(.2,.6,.2,1)}.expanded-grid .project:hover img{transform:scale(1.04)}.project{transition:opacity .65s,translate .65s}.js-motion .project.awaiting{opacity:0;translate:0 35px}.work-end a{color:var(--acid);font-size:14px}.pdf-download{padding:15px 20px;border:1px solid var(--line);border-radius:40px;white-space:nowrap;font-size:14px}.contact-info{flex-wrap:wrap}.hero-gallery{perspective:1000px}.piece-one{animation:drift-one 8s ease-in-out infinite}.piece-two{animation:drift-two 10s ease-in-out infinite}.hero-gallery:hover .hero-piece{animation-play-state:paused}.hero-sticker{animation:sticker-turn 12s ease-in-out infinite}.case-gallery figure{background:#181a13;padding:12px}.case-gallery figure.full{padding:0;background:transparent}.case-gallery figcaption{padding:13px 8px 6px}.case-gallery .full figcaption{padding-left:0}.case-header{border-bottom:1px solid var(--line);margin-bottom:25px}.case-header h2{overflow-wrap:break-word}.case-progress{position:fixed;left:0;top:0;height:3px;width:var(--progress,0%);background:var(--acid);z-index:40;pointer-events:none}.all-projects{font-size:14px;color:var(--acid);border-bottom:1px solid;padding-bottom:5px}.case-next{gap:30px}@keyframes drift-one{0%,100%{transform:rotate(-8deg) translateY(0)}50%{transform:rotate(-5deg) translateY(-12px)}}@keyframes drift-two{0%,100%{transform:rotate(9deg) translateY(0)}50%{transform:rotate(5deg) translateY(10px)}}@keyframes sticker-turn{0%,100%{transform:rotate(13deg)}50%{transform:rotate(-9deg)}}@media(max-width:900px){.expanded-grid .project-caption p{max-width:none;flex-basis:100%;margin-left:29px}.work-tools{align-items:flex-start}}@media(max-width:600px){.work-tools{flex-direction:column;gap:15px}.filter{font-size:13px;padding:10px 14px}.expanded-grid .project-image,.expanded-grid .wide-project .project-image{aspect-ratio:1.15}.project-tag{top:12px;left:12px;font-size:10px;max-width:90%}.expanded-grid .project-caption h3{font-size:27px}.expanded-grid .project-caption p{font-size:14px;line-height:1.5;flex-basis:100%;margin:0 0 0 28px}.work-end{flex-direction:column;gap:20px}.case-next{flex-wrap:wrap}.case-next span{width:100%}.case-next small{font-size:12px}.hero .serif{letter-spacing:-.04em}.case-gallery figure{padding:8px}.case-gallery figure.full{padding:0}}
@media(prefers-reduced-motion:reduce){.js-motion .project.awaiting{opacity:1;translate:none}}
